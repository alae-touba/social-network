# Values used by `docker compose up` (full stack) when interpolating
# docker-compose.yaml. Copy to .env in the repo root to override.
# Local development against a single database uses docker-compose.dev.yaml
# instead - see README "Local development".

APP_PORT=3000
ADMINER_PORT=8082

POSTGRES_HOST_PORT=5433
POSTGRES_DB=social_network_db
POSTGRES_PASSWORD=secret

SESSION_SECRET=change-me-in-production
