# Copy this file to .env and adjust as needed.
# All values below are the local-development defaults.

NODE_ENV=development
PORT=3000

# PostgreSQL connection (matches docker-compose defaults)
DATABASE_URL=postgresql://postgres:secret@localhost:5433/social_network_db?schema=public

# Session signing key - set your own random value in production
SESSION_SECRET=change-me

# Set to true only when serving over HTTPS
SESSION_SECURE_COOKIE=false

# Where the built Angular app lives, relative to server/
SPA_DIR=../client/dist/social-network/browser
