# Copy this file to server/.env to customize the local backend.
# Spring Boot loads it automatically (see spring.config.import in
# application.yml); real environment variables take precedence.
# All values below are the local-development defaults.

PORT=3000

# PostgreSQL JDBC connection (matches docker-compose.dev.yaml defaults)
DATABASE_URL=jdbc:postgresql://localhost:5433/social_network_db
DB_USERNAME=postgres
DB_PASSWORD=secret

# HS256 signing key for JWTs - use a strong random value in production (min 32 chars)
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
