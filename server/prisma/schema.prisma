generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

// Ids are plain strings: seeded rows keep their legacy hex ids, new rows get cuids.
model User {
	id               String     @id @default(cuid())
	firstName        String
	lastName         String
	email            String     @unique
	password         String
	imageName        String
	registrationDate DateTime   @default(now())
	createdTopics    Topic[]    @relation("TopicAuthor")
	questions        Question[]
	answers          Answer[]
	follows          Follow[]
	likes            Like[]

	@@map("users")
}

model Topic {
	id           String     @id @default(cuid())
	name         String     @unique
	description  String
	imageName    String
	creationDate DateTime   @default(now())
	author       User       @relation("TopicAuthor", fields: [userId], references: [id])
	userId       String
	questions    Question[]
	followers    Follow[]

	@@map("topics")
}

model Question {
	id           String   @id @default(cuid())
	content      String
	creationDate DateTime @default(now())
	user         User     @relation(fields: [userId], references: [id])
	userId       String
	topic        Topic    @relation(fields: [topicId], references: [id])
	topicId      String
	answers      Answer[]

	@@map("questions")
}

model Answer {
	id           String   @id @default(cuid())
	content      String
	creationDate DateTime @default(now())
	user         User     @relation(fields: [userId], references: [id])
	userId       String
	question     Question @relation(fields: [questionId], references: [id])
	questionId   String
	likes        Like[]

	@@map("answers")
}

model Follow {
	userId    String
	topicId   String
	user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
	topic     Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

	@@id([userId, topicId])
	@@map("follows")
}

model Like {
	userId   String
	answerId String
	user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
	answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

	@@id([userId, answerId])
	@@map("likes")
}
