{
	"name": "social-network-server",
	"version": "1.0.0",
	"private": true,
	"description": "JSON API + static file server for the Q&A social network",
	"main": "index.js",
	"scripts": {
		"start": "node index.js",
		"dev": "nodemon index.js",
		"db:init": "node scripts/ensure-env.js && node scripts/wait-for-db.js && prisma migrate deploy && node scripts/seed.js --if-empty",
		"db:reset": "prisma migrate reset --force",
		"migrate:dev": "prisma migrate dev",
		"migrate:deploy": "prisma migrate deploy",
		"seed": "prisma db seed"
	},
	"prisma": {
		"seed": "node scripts/seed.js"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@prisma/client": "6.19.3",
		"bcryptjs": "^2.4.3",
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"express-rate-limit": "^7.5.0",
		"express-session": "^1.18.1",
		"express-validator": "^7.2.1",
		"helmet": "^8.1.0",
		"morgan": "^1.10.0",
		"multer": "^2.0.1",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0",
		"prisma": "6.19.3"
	},
	"devDependencies": {
		"nodemon": "^3.1.9"
	}
}
